   "orcid_source_url": null,
   "homepage_url": null,
   "bio": "Assistant Manager (formerly GIS and Stewardship Coordinator) of the Jacques Cousteau NERR. A GIS and remote-sensing specialist, she runs the reserve's long-term habitat-change monitoring, notably salt marsh and beach-dune elevation relative to sea-level rise, much of it done with NPS and USFWS inventory partners.",
   "bio_source_url": "https://jcnerr.org/who-we-are/our-team/",
   "research_interests": "Habitat change monitoring; marsh and dune elevation and sea-level rise; GIS, remote sensing and survey-grade GPS.",
   "research_interests_source_url": "https://jcnerr.org/who-we-are/our-team/"
  },
