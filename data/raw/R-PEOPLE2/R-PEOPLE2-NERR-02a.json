   "orcid_source_url": "https://pub.orcid.org/v3.0/0000-0003-2095-8286/employments",
   "homepage_url": null,
   "bio": "Research Coordinator of the Jacques Cousteau NERR and Research Associate Professor in Rutgers' Department of Marine and Coastal Sciences, advising graduate students in oceanography and ecology. His work examines what controls fish abundance and distribution and develops autonomous underwater vehicle and sonar methods for tracking and imaging fishes.",
   "bio_source_url": "https://jcnerr.org/who-we-are/our-team/",
   "research_interests": "Fish distribution and abundance in relation to currents, climate and habitat; autonomous underwater vehicles for fish tracking; sonar image classification.",
   "research_interests_source_url": "https://jcnerr.org/who-we-are/our-team/"
  },
  {
