   "homepage_url": null,
   "bio": "Reserve Manager of the Jacques Cousteau NERR at Rutgers, where he leads integrated research, education and outreach programs spanning the reserve plus Rutgers' aquaculture and coastal exploration centers. He has served as president of NERRA and of the National Association of Marine Laboratories, and leads Rutgers aquaculture development work.",
   "bio_source_url": "https://jcnerr.org/who-we-are/our-team/",
   "research_interests": "Coastal management and marine protected areas; coastal resilience after extreme events; environmental sensing networks; shellfish aquaculture (surf clam, bay scallop, ribbed mussel).",
   "research_interests_source_url": "https://jcnerr.org/who-we-are/our-team/"
  },
  {
   "key": "thomas-grothues",
   "existing_person_id": null,
